# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sentinelops

# RabbitMQ Credentials
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq

# AI Agent Configuration
# Example: AIza... (Replace with your actual API key)
# GEMINI_API_KEY=your_gemini_api_key_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Services Configuration
REDIS_URL=redis://redis:6379/0

# Pacing
HEAL_MIN_SECONDS=10
HEAL_DEADLINE_SECONDS=15
APPROVAL_MIN_SECONDS=15
# Circuit Breaker (2 is the safe production value, 1000 is for the demo)
BREAKER_MAX_REMEDIATIONS=1000
