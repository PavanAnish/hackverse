# Discord Webhook Integration — .env.example
# ============================================
# Copy this file to .env and fill in the real values.
# .env is listed in .gitignore and must NEVER be committed.
#
# How to create a Discord Incoming Webhook:
#   Discord channel → Edit Channel → Integrations → Webhooks → New Webhook
#   Copy the Webhook URL and paste it below.

# Required: Discord Incoming Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_YOUR_WEBHOOK_ID/REPLACE_WITH_YOUR_WEBHOOK_TOKEN

# Optional: Read-only PostgreSQL DSN for DB-backed counts in the final summary.
# Required for Findings / Incidents / Recommendations / Executions / Verifications counts.
# If omitted, all counts show UNAVAILABLE.
# Format: postgresql://user:password@host:port/dbname
# The password comes from infrastructure/docker/.env (POSTGRES_PASSWORD).
# ZERAXIS_PG_DSN=postgresql://postgres:postgres@localhost:5433/zeraxis

